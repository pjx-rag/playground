<div class="flex flex-col h-[calc(100svh-8rem)] md:h-[calc(100svh-7.25rem)]">
  <%!-- Main Chat Area --%>
  <div class="flex-1 flex flex-col min-w-0 min-h-0 overflow-hidden">
    <%= if @current_chat do %>

      <%!-- Messages Area --%>
      <div class="flex-1 overflow-y-auto px-4 md:px-6 py-4 space-y-4 relative" id="messages-container" phx-hook="ChatScroll">
        <%= for message <- @messages do %>
          <div class={"flex #{if message.role == "user", do: "justify-end", else: "justify-start"}"}>
            <div class={"max-w-[85%] md:max-w-3xl"}>
              <div class={"px-4 py-3 #{if message.role == "user", do: "bg-primary text-foreground-primary rounded-2xl rounded-br-sm", else: "bg-card border border-base text-foreground shadow-sm rounded-2xl rounded-bl-sm"}"}>
                <%= if message.role == "assistant" do %>
                  <div class="prose prose-sm max-w-none dark:prose-invert">
                    {raw(MDEx.to_html!(message.content, sanitize: MDEx.Document.default_sanitize_options()))}
                  </div>
                <% else %>
                  <div>{message.content}</div>
                <% end %>
              </div>

              <%!-- RAG Citations Display --%>
              <%= if message.role == "assistant" && message.chunks_used && message.chunks_used > 0 do %>
                <div class="mt-2 px-4 py-2 bg-overlay border border-base rounded-base text-xs">
                  <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center gap-2 text-muted-foreground">
                      <.icon name="hero-document-text" class="size-3" />
                      <span class="font-medium">Sources</span>
                    </div>
                    <%= if message.rag_debug_data do %>
                      <.button
                        variant="ghost"
                        size="xs"
                        phx-click={Fluxon.open_dialog("rag-debug-#{message.id}")}
                      >
                        <.icon name="hero-bug-ant" class="size-3 mr-1" />
                        Debug
                      </.button>
                    <% end %>
                  </div>
                  <div class="space-y-1">
                    <%= if all_citations = get_in(message.rag_debug_data, ["citations"]) do %>
                      <%!-- Filter to only citations actually used in the message, then group by file --%>
                      <% used_citations = PlaygroundWeb.AIChatLive.filter_used_citations(all_citations, message.content) %>
                      <% files_with_positions = Enum.group_by(used_citations, & &1["file_name"]) %>
                      <%= for {file_name, file_citations} <- files_with_positions do %>
                        <% first_citation = List.first(file_citations) %>
                        <%!-- Get position numbers for this file, sorted --%>
                        <% positions = file_citations |> Enum.map(& &1["position"]) |> Enum.sort() %>
                        <div class="flex items-start gap-2 text-foreground-soft">
                          <span class="font-mono text-primary text-[10px] whitespace-nowrap">
                            <%= for pos <- positions do %>[{pos}]<% end %>
                          </span>
                          <div class="flex-1">
                            <%= if first_citation["file_url"] do %>
                              <a
                                href={first_citation["file_url"]}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="font-medium text-primary hover:underline"
                              >
                                {file_name}
                                <.icon name="hero-arrow-top-right-on-square" class="size-3 inline ml-0.5" />
                              </a>
                            <% else %>
                              <span class="font-medium">{file_name}</span>
                            <% end %>
                          </div>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <%!-- Streaming Content --%>
        <%= if @is_streaming do %>
          <div class="flex justify-start">
            <div class="max-w-[85%] md:max-w-3xl px-4 py-3 rounded-2xl rounded-bl-sm bg-card border border-base text-foreground shadow-sm">
              <%= if @streaming_content != "" do %>
                <div class="prose prose-sm max-w-none dark:prose-invert">
                  {raw(MDEx.to_html!(@streaming_content, sanitize: MDEx.Document.default_sanitize_options()))}
                </div>
              <% end %>
              <div class="mt-2 flex items-center text-xs text-muted-foreground">
                <span class="animate-pulse">●</span>
                <span class="ml-2">AI is typing...</span>
              </div>
            </div>
          </div>
        <% end %>

        <%!-- Scroll to bottom button --%>
        <button
          id="scroll-to-bottom"
          class="hidden sticky bottom-4 left-1/2 -translate-x-1/2 bg-primary text-foreground-primary px-4 py-2 rounded-full shadow-lg hover:bg-primary/90 transition-all z-10"
          phx-click={JS.dispatch("scroll-to-bottom", to: "#messages-container")}
        >
          <.icon name="hero-arrow-down" class="size-4 mr-1 inline" />
          New messages
        </button>
      </div>

      <%!-- Input Area - sticky --%>
      <div class="sticky bottom-0 z-10 border-t border-base px-4 md:px-6 py-3 md:py-4 bg-card">
        <%= if @viewed_user_id == @current_user.id do %>
          <%!-- Rate Limit Display (hidden on mobile for space) --%>
          <div class="hidden md:block mb-2 text-xs text-muted-foreground">
            Rate limit: {@rate_limit.per_minute.remaining}/{@rate_limit.per_minute.limit} per min,
            {@rate_limit.per_hour.remaining}/{@rate_limit.per_hour.limit} per hour,
            {@rate_limit.per_day.remaining}/{@rate_limit.per_day.limit} per day
          </div>

          <.form for={%{}} phx-submit="send_message" class="flex gap-2">
            <div class="flex-1">
              <.input
                type="text"
                id="message-input"
                name="message[content]"
                value={@input_value}
                placeholder="Type your message..."
                disabled={@is_streaming}
                autocomplete="off"
                phx-hook="AutoFocus"
              />
            </div>
            <.button
              type="submit"
              variant="solid"
              color="primary"
              disabled={@is_streaming}
              class="flex-shrink-0"
            >
              <.icon name="hero-paper-airplane" class="size-4 md:mr-1" />
              <span class="hidden md:inline">Send</span>
            </.button>
          </.form>
        <% else %>
          <div class="text-center text-muted-foreground py-4">
            Viewing {@viewed_user.email}'s chats - cannot send messages
          </div>
        <% end %>
      </div>
    <% else %>
      <%!-- No Chat Selected --%>
      <div class="flex-1 flex items-center justify-center p-4">
        <div class="text-center">
          <p class="text-lg md:text-xl text-muted-foreground mb-4">Select a chat or create a new one</p>
          <%= if @viewed_user_id == @current_user.id do %>
            <.button
              variant="solid"
              color="primary"
              size="lg"
              phx-click="new_chat"
            >
              <.icon name="hero-plus" class="size-5 mr-2" />
              New Chat
            </.button>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<%!-- Chat History & Settings Sheet --%>
<.sheet id="chat-history-sheet" placement="right" class="w-full max-w-sm">
  <div class="flex flex-col h-full pt-6">
    <%!-- Header with New Chat button --%>
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-semibold text-foreground">Chats</h2>
      <%= if @viewed_user_id == @current_user.id do %>
        <.button
          variant="solid"
          color="primary"
          size="sm"
          phx-click={JS.push("new_chat") |> Fluxon.close_dialog("chat-history-sheet")}
        >
          <.icon name="hero-plus" class="size-4 mr-1" />
          New Chat
        </.button>
      <% end %>
    </div>

    <%!-- Chat List --%>
    <div class="flex-1 overflow-y-auto space-y-2">
      <%= if length(@chats) == 0 do %>
        <p class="text-sm text-muted-foreground text-center py-4">No chats yet</p>
      <% else %>
        <%= for chat <- @chats do %>
          <div
            class={"group relative px-3 py-2 rounded-base cursor-pointer transition-colors #{if @current_chat && @current_chat.id == chat.id, do: "bg-primary text-foreground-primary", else: "bg-overlay hover:bg-muted text-foreground"}"}
          >
            <div
              phx-click={JS.push("select_chat", value: %{chat_id: chat.id}) |> Fluxon.close_dialog("chat-history-sheet")}
            >
              <div class="flex items-center justify-between">
                <span class="truncate flex-1 pr-8">{chat.title}</span>
                <%= if chat.is_processing do %>
                  <span class="text-xs ml-2 animate-pulse">●</span>
                <% end %>
              </div>
              <div class="text-xs opacity-70 mt-1">
                {Calendar.strftime(chat.updated_at, "%b %d, %I:%M %p")}
              </div>
            </div>
            <%!-- Delete button --%>
            <%= if @viewed_user_id == @current_user.id do %>
              <button
                phx-click="delete_chat"
                phx-value-chat_id={chat.id}
                data-confirm="Are you sure you want to delete this chat?"
                class={"absolute right-2 top-1/2 -translate-y-1/2 p-1.5 rounded-base #{if @current_chat && @current_chat.id == chat.id, do: "text-foreground-primary hover:bg-primary-foreground/20", else: "text-danger hover:bg-danger/10"}"}
              >
                <.icon name="hero-trash" class="size-4" />
              </button>
            <% end %>
          </div>
        <% end %>

        <%!-- Delete All Chats --%>
        <%= if @viewed_user_id == @current_user.id do %>
          <div class="pt-4 mt-4 border-t border-base">
            <.button
              variant="solid"
              color="danger"
              class="w-full"
              phx-click="delete_all_chats"
              data-confirm="Are you sure you want to delete ALL your chats? This cannot be undone."
            >
              <.icon name="hero-trash" class="size-4 mr-2" />
              Delete All Chats
            </.button>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</.sheet>

<%!-- Admin AI Settings Sheet --%>
<%= if @is_admin do %>
  <.sheet id="ai-settings-sheet" placement="right" class="w-full max-w-sm">
    <div class="flex flex-col h-full pt-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-foreground flex items-center">
          <.icon name="hero-cog-6-tooth" class="size-5 mr-2" />
          AI Settings
        </h2>
      </div>

      <%!-- Admin User Selector --%>
      <div class="mb-4 pb-4 border-b border-base">
        <.label class="mb-1 text-xs">Viewing chats for:</.label>
        <.select
          name="user_id"
          value={cond do
            @viewed_user_id == @current_user.id -> ""
            is_nil(@viewed_user_id) -> "all"
            true -> @viewed_user_id
          end}
          options={[
            {"#{@current_user.email} (You)", ""},
            {"All Users", "all"}
          ] ++ Enum.map(Enum.filter(@available_users, & &1.id != @current_user.id), &{&1.email, &1.id})}
          phx-change="change_viewed_user"
        />
      </div>

      <p class="text-xs text-muted-foreground mb-4">
        Default settings for all new chats. Changes are saved immediately.
      </p>

      <.form for={%{}} phx-change="update_ai_settings" class="space-y-4 flex-1 overflow-y-auto">
        <div>
          <.label class="text-xs mb-1">Default Model</.label>
          <.select
            name="default_model"
            value={@ai_settings.default_model}
            options={@available_models}
            searchable
            search_input_placeholder="Search models..."
          />
        </div>

        <div>
          <.label class="text-xs mb-1">RAG Mode</.label>
          <.select
            name="rag_mode"
            value={@ai_settings.rag_mode}
            options={[
              {"Simple RAG (Fast)", "rag"},
              {"Agentic RAG (Advanced)", "agentic_rag"}
            ]}
          />
          <p class="text-xs text-muted-foreground mt-1">
            Simple: Fast retrieval + answer. Agentic: Intelligent gating, decomposition, and multi-hop reasoning.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <.label class="text-xs mb-1">Temperature</.label>
            <.input
              type="number"
              name="temperature"
              value={@ai_settings.temperature}
              step="0.1"
              min="0"
              max="2"
              phx-debounce="500"
            />
          </div>
          <div>
            <.label class="text-xs mb-1">Max Tokens</.label>
            <.input
              type="number"
              name="max_tokens"
              value={@ai_settings.max_tokens}
              step="256"
              min="1"
              max="128000"
              phx-debounce="500"
            />
          </div>
        </div>

        <div class="grid grid-cols-3 gap-2">
          <div>
            <.label class="text-xs mb-1">Top P</.label>
            <.input
              type="number"
              name="top_p"
              value={@ai_settings.top_p}
              step="0.1"
              min="0"
              max="1"
              phx-debounce="500"
            />
          </div>
          <div>
            <.label class="text-xs mb-1">Freq Pen</.label>
            <.input
              type="number"
              name="frequency_penalty"
              value={@ai_settings.frequency_penalty}
              step="0.1"
              min="-2"
              max="2"
              phx-debounce="500"
            />
          </div>
          <div>
            <.label class="text-xs mb-1">Pres Pen</.label>
            <.input
              type="number"
              name="presence_penalty"
              value={@ai_settings.presence_penalty}
              step="0.1"
              min="-2"
              max="2"
              phx-debounce="500"
            />
          </div>
        </div>
      </.form>
    </div>
  </.sheet>
<% end %>

<%!-- RAG Debug Sheets (one per message with RAG data) --%>
<%= for message <- @messages do %>
  <%= if message.role == "assistant" && message.rag_debug_data do %>
    <% metadata = get_in(message.rag_debug_data, ["metadata"]) || %{} %>
    <% steps = metadata["steps"] || [] %>
    <% citations = get_in(message.rag_debug_data, ["citations"]) || [] %>
    <% started_at = metadata["started_at"] %>
    <% used_positions = PlaygroundWeb.AIChatLive.extract_used_citations(message.content) %>

    <.sheet id={"rag-debug-#{message.id}"} placement="right" class="w-full max-w-3xl">
      <div class="flex flex-col h-full pt-6">
        <%!-- Header --%>
        <div class="flex items-center justify-between mb-4 pb-4 border-b border-base">
          <div class="flex items-center gap-3">
            <h2 class="text-lg font-semibold text-foreground">RAG Debug</h2>
            <.badge color={if message.rag_mode == "agentic_rag", do: "primary", else: "info"} size="sm">
              {if message.rag_mode == "agentic_rag", do: "Agentic", else: "Simple"}
            </.badge>
          </div>
          <div class="flex items-center gap-3 text-xs text-muted-foreground">
            <span><span class="font-medium text-foreground">{message.chunks_used || 0}</span> chunks</span>
            <span><span class="font-medium text-foreground">{length(steps)}</span> steps</span>
          </div>
        </div>

        <div class="flex-1 overflow-y-auto space-y-6">
          <%!-- Pipeline Steps Timeline --%>
          <%= if length(steps) > 0 do %>
            <div class="space-y-3">
              <div class="text-sm font-medium text-foreground">Pipeline Steps</div>
              <div class="relative pl-6 space-y-4">
                <%!-- Timeline line --%>
                <div class="absolute left-2 top-2 bottom-2 w-px bg-base"></div>

                <%= for {step, idx} <- Enum.with_index(steps) do %>
                  <% step_name = step["step"] %>
                  <div class="relative">
                    <%!-- Timeline dot --%>
                    <div class="absolute -left-6 top-1.5 w-3 h-3 rounded-full bg-primary border-2 border-overlay"></div>

                    <div class="bg-overlay border border-base rounded-lg p-3">
                      <div class="flex items-center justify-between mb-1">
                        <div class="flex items-center gap-2">
                          <span class="font-medium text-sm text-foreground">
                            <%= case step_name do %>
                              <% "gate" -> %>Gate
                              <% "decompose" -> %>Decompose
                              <% "search" -> %>Search
                              <% "rerank" -> %>Rerank
                              <% "reason" -> %>Reason
                              <% "answer" -> %>Answer
                              <% _ -> %>{String.capitalize(to_string(step_name))}
                            <% end %>
                          </span>
                          <span class="group relative">
                            <.icon name="hero-information-circle" class="size-3.5 text-muted-foreground cursor-help" />
                            <div class="absolute left-0 bottom-full mb-1 hidden group-hover:block z-50 w-64 p-2 text-xs bg-overlay border border-base rounded-lg shadow-lg">
                              <%= case step_name do %>
                                <% "gate" -> %>
                                  LLM decides if document retrieval is needed. Simple greetings skip retrieval; questions about documents trigger search.
                                <% "decompose" -> %>
                                  LLM breaks complex questions into sub-questions. Each sub-question is searched separately for better coverage.
                                <% "search" -> %>
                                  Hybrid search: 70% semantic (vector similarity) + 30% keyword. Each sub-question returns 20 results. Results are merged using Reciprocal Rank Fusion (RRF): chunks appearing in multiple queries get higher scores, ensuring diverse results from all sub-questions. Top 30 chunks are kept.
                                <% "rerank" -> %>
                                  LLM scores each chunk 0-10 for relevance. 10 = directly answers, 5-9 = related context, 0-4 = unrelated.
                                <% "reason" -> %>
                                  Evaluates if retrieved context is sufficient. If top chunk scores ≥ 7, context is marked sufficient. Otherwise marked as "limited" but proceeds anyway (no retry loop implemented yet).
                                <% "answer" -> %>
                                  Top 10 chunks are injected into LLM prompt. Response is generated with numbered citations [1], [2], etc.
                                <% _ -> %>
                                  Pipeline step completed.
                              <% end %>
                            </div>
                          </span>
                        </div>
                        <%= if step["timestamp"] && started_at do %>
                          <span class="text-xs font-mono text-muted-foreground">
                            <%= try do
                              {:ok, start_dt, _} = DateTime.from_iso8601(started_at)
                              {:ok, step_dt, _} = DateTime.from_iso8601(step["timestamp"])
                              ms = DateTime.diff(step_dt, start_dt, :millisecond)
                              "+#{Float.round(ms / 1000, 2)}s"
                            rescue
                              _ -> ""
                            end %>
                          </span>
                        <% end %>
                      </div>
                      <div class="text-xs text-foreground-soft">
                        <%= cond do %>
                          <% step_name == "gate" -> %>
                            <span class={if step["needs_retrieval"], do: "text-success", else: "text-warning"}>
                              {if step["needs_retrieval"], do: "Retrieval needed", else: "Skipped retrieval"}
                            </span>
                          <% step_name == "decompose" && step["sub_questions"] -> %>
                            <div class="space-y-0.5">
                              <%= for {q, i} <- Enum.with_index(step["sub_questions"], 1) do %>
                                <div class="text-foreground-soft">{i}. {q}</div>
                              <% end %>
                            </div>
                          <% step_name == "search" -> %>
                            {step["num_queries"] || 1} queries → {step["num_results"] || 0} results
                          <% step_name == "rerank" -> %>
                            {step["num_ranked"] || 0} chunks scored
                          <% step_name == "reason" -> %>
                            <span class={if step["context_sufficient"], do: "text-success", else: "text-warning"}>
                              {if step["context_sufficient"], do: "Context sufficient", else: "Context limited"}
                            </span>
                          <% step_name == "answer" -> %>
                            Response generated
                          <% true -> %>
                            Step completed
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>

          <%!-- Retrieved Chunks Table --%>
          <%= if length(citations) > 0 do %>
            <div class="space-y-2">
              <div class="text-sm font-medium text-foreground">Retrieved Chunks ({length(citations)})</div>
              <div class="overflow-x-auto border border-base rounded-lg">
                <table class="w-full text-xs">
                  <thead>
                    <tr class="bg-overlay border-b border-base text-left">
                      <th class="px-3 py-2 font-medium text-muted-foreground">Ref</th>
                      <th class="px-3 py-2 font-medium text-muted-foreground">File</th>
                      <th class="px-3 py-2 font-medium text-muted-foreground text-right">Semantic</th>
                      <th class="px-3 py-2 font-medium text-muted-foreground text-right">Hybrid</th>
                      <th class="px-3 py-2 font-medium text-muted-foreground text-right">Rank</th>
                      <th class="px-3 py-2 font-medium text-muted-foreground text-center">Cited</th>
                      <th class="px-3 py-2 font-medium text-muted-foreground">Content</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-base">
                    <%= for citation <- citations do %>
                      <% is_used = citation["position"] in used_positions %>
                      <tr class={if is_used, do: "bg-success/5", else: ""}>
                        <td class="px-3 py-2">
                          <span class={"font-mono font-semibold #{if is_used, do: "text-success", else: "text-muted-foreground"}"}>
                            [{citation["position"]}]
                          </span>
                        </td>
                        <td class="px-3 py-2">
                          <%= if citation["file_id"] do %>
                            <.link
                              navigate={~p"/admin/files/#{citation["file_id"]}"}
                              class="text-primary hover:underline inline-flex items-center gap-1"
                            >
                              <span class="max-w-32 truncate" title={citation["file_name"]}>{citation["file_name"]}</span>
                              <.icon name="hero-arrow-top-right-on-square" class="size-3 flex-shrink-0" />
                            </.link>
                          <% else %>
                            <span class="text-foreground max-w-32 truncate" title={citation["file_name"]}>{citation["file_name"]}</span>
                          <% end %>
                        </td>
                        <td class="px-3 py-2 text-right font-mono text-foreground-soft">
                          {if citation["semantic_score"], do: Float.round(citation["semantic_score"] / 1.0, 3), else: "-"}
                        </td>
                        <td class="px-3 py-2 text-right font-mono text-foreground-soft">
                          {if citation["hybrid_score"], do: Float.round(citation["hybrid_score"] / 1.0, 3), else: "-"}
                        </td>
                        <td class="px-3 py-2 text-right font-mono text-foreground-soft">
                          {citation["rerank_score"] || "-"}
                        </td>
                        <td class="px-3 py-2 text-center">
                          <%= if is_used do %>
                            <.icon name="hero-check-circle" class="size-4 text-success" />
                          <% else %>
                            <.icon name="hero-minus-circle" class="size-4 text-muted-foreground" />
                          <% end %>
                        </td>
                        <td class="px-3 py-2">
                          <%= if citation["chunk_id"] do %>
                            <button
                              type="button"
                              class="text-primary hover:underline text-xs"
                              phx-click={JS.push("view_chunk", value: %{chunk_id: citation["chunk_id"]}) |> Fluxon.open_dialog("chunk-viewer")}
                            >
                              View
                            </button>
                          <% else %>
                            <span class="text-muted-foreground">-</span>
                          <% end %>
                        </td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </.sheet>
  <% end %>
<% end %>

<%!-- Chunk Content Viewer Modal --%>
<.modal id="chunk-viewer" class="max-w-2xl">
  <%= if @viewing_chunk do %>
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-lg font-semibold text-foreground">Chunk Content</h3>
        <div class="text-xs text-muted-foreground">
          ID: <span class="font-mono">{@viewing_chunk.id}</span>
          · Position: <span class="font-mono">{@viewing_chunk.position}</span>
        </div>
      </div>
      <div class="bg-card border border-base rounded-lg p-4 max-h-96 overflow-y-auto">
        <pre class="text-sm text-foreground-soft whitespace-pre-wrap font-mono">{@viewing_chunk.content}</pre>
      </div>
    </div>
  <% end %>
</.modal>
